# ── BACKEND servisi için (Python/FastAPI) ─────────────────────────────────────
TELEGRAM_TOKEN=your_bot_token_here
# 1. kullanıcının chat ID'si. İlk kurulumda users tablosuna yazılır; sonrasında
# sahibi bulunamayan bildirimlerin düştüğü yedek adres olarak kullanılır.
# İKİNCİ KİŞİYİ BURAYA EKLEME — `python kullanici.py chat-id "Ad" <id>` ile eklenir.
TELEGRAM_CHAT_ID=your_chat_id_here
GROQ_API_KEY=your_groq_api_key_here
# REST API koruması — rastgele uzun bir değer üret (boş bırakılırsa auth devre dışı, sadece lokal için).
# DİKKAT: bu anahtarla gelen istek her zaman 1. kullanıcı sayılır (Android uygulaması).
API_KEY=your_random_api_key_here
# SADECE İLK KURULUM: kayıtlı kullanıcı yokken 1. kullanıcı bu parolayla yaratılır.
# Sonrasında parolalar veritabanında (scrypt karması) durur ve burası okunmaz —
# değiştirmek için: python kullanici.py parola "<ad>"
PANEL_PASSWORD=panel_icin_parolan
# İlk kullanıcının adı (yalnız ilk kurulumda). Yazılmazsa "Eyüp".
# PANEL_USER_NAME=Eyüp
# Panel oturum biletinin imza anahtarı — rastgele uzun bir değer üret.
# Yazılmazsa API_KEY kullanılır (eski davranış). Değiştirilirse açık oturumlar düşer.
SESSION_SECRET=your_random_session_secret_here
# Telegram webhook imza doğrulaması — rastgele uzun bir değer üret (boşsa doğrulama devre dışı)
TELEGRAM_WEBHOOK_SECRET=your_random_webhook_secret_here
WEBHOOK_URL=https://kendi-alan-adin.example.com
# Panelin adresi — bot "site linkini ver" dendiğinde bunu veriyor.
# Yazılmazsa WEBHOOK_URL kullanılır; panel aynı alan adının kökünde olduğu için
# normalde gerekmez. Yalnız panel başka bir adrese taşınırsa doldur.
# PANEL_URL=https://panel.ornek.com
# CORS: izin verilen origin'ler, virgülle ayrılır.
# DİKKAT: satırı hiç yazmazsan tüm origin'ler serbest; BOŞ bırakırsan hepsi ENGELLENİR.
# Web paneli yayına alınmadıysa bu satırı hiç ekleme.
# CORS_ORIGINS=https://panel.ornek.com
# Groq modelleri (hepsi opsiyonel — yazılmazsa koddaki varsayılan kullanılır).
# Groq zaman zaman model emekliye ayırıyor; "model_not_found" hatası alırsan
# güncel listeyi çekip buradaki değeri değiştir, kod değişikliği gerekmez:
#   curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# GROQ_MODEL=llama-3.3-70b-versatile          # metin anlama / komut ayrıştırma
# GROQ_WHISPER_MODEL=whisper-large-v3         # ses → yazı
# GROQ_VISION_MODEL=qwen/qwen3.6-27b          # görsel analiz
# Varsayılan konum: konumunu hiç paylaşmamış kullanıcılar için kullanılır.
# Panele giren kişinin konumu users tablosuna yazılır ve onunkiler bunu geçersiz kılar.
WEATHER_CITY=Elazığ
WEATHER_LAT=38.6748
WEATHER_LON=39.2225
TZ=Europe/Istanbul
DATABASE_PATH=/data/prism.db

# Sesli cevap (ses.py). Boş bırakılabilir — varsayılanlar çalışır.
# Kadın ses: tr-TR-EmelNeural
TTS_VOICE=tr-TR-AhmetNeural
TTS_MAX_CHARS=1200
