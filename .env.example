# ── BACKEND servisi için (Python/FastAPI) ─────────────────────────────────────
TELEGRAM_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
GROQ_API_KEY=your_groq_api_key_here
# REST API koruması — rastgele uzun bir değer üret (boş bırakılırsa auth devre dışı, sadece lokal için)
API_KEY=your_random_api_key_here
# Web paneline giriş parolası — akılda kalır bir şey seç, panelde bunu yazacaksın.
# Boş bırakılırsa panele giriş yapılamaz (REST API, API_KEY ile çalışmaya devam eder).
PANEL_PASSWORD=panel_icin_parolan
# Telegram webhook imza doğrulaması — rastgele uzun bir değer üret (boşsa doğrulama devre dışı)
TELEGRAM_WEBHOOK_SECRET=your_random_webhook_secret_here
WEBHOOK_URL=https://kendi-alan-adin.example.com
# CORS: izin verilen origin'ler, virgülle ayrılır.
# DİKKAT: satırı hiç yazmazsan tüm origin'ler serbest; BOŞ bırakırsan hepsi ENGELLENİR.
# Web paneli yayına alınmadıysa bu satırı hiç ekleme.
# CORS_ORIGINS=https://panel.ornek.com
# Groq modelleri (hepsi opsiyonel — yazılmazsa koddaki varsayılan kullanılır).
# Groq zaman zaman model emekliye ayırıyor; "model_not_found" hatası alırsan
# güncel listeyi çekip buradaki değeri değiştir, kod değişikliği gerekmez:
#   curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# GROQ_MODEL=llama-3.3-70b-versatile          # metin anlama / komut ayrıştırma
# GROQ_WHISPER_MODEL=whisper-large-v3         # ses → yazı
# GROQ_VISION_MODEL=qwen/qwen3.6-27b          # görsel analiz
WEATHER_CITY=Elazığ
WEATHER_LAT=38.6748
WEATHER_LON=39.2225
TZ=Europe/Istanbul
DATABASE_PATH=/data/prism.db
