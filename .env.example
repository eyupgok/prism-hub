# ── BACKEND servisi için (Python/FastAPI) ─────────────────────────────────────
TELEGRAM_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
GROQ_API_KEY=your_groq_api_key_here
# REST API koruması — rastgele uzun bir değer üret (boş bırakılırsa auth devre dışı, sadece lokal için)
API_KEY=your_random_api_key_here
# Telegram webhook imza doğrulaması — rastgele uzun bir değer üret (boşsa doğrulama devre dışı)
TELEGRAM_WEBHOOK_SECRET=your_random_webhook_secret_here
WEBHOOK_URL=https://your-backend.railway.app
# CORS: izin verilen origin'ler, virgülle ayrılır (boş bırakılırsa tüm origin'ler serbest)
CORS_ORIGINS=https://your-frontend.railway.app
# Görsel analiz modeli (opsiyonel, varsayılan: meta-llama/llama-4-scout-17b-16e-instruct)
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
WEATHER_CITY=Elazığ
WEATHER_LAT=38.6748
WEATHER_LON=39.2225
TZ=Europe/Istanbul
DATABASE_PATH=/data/prism.db
